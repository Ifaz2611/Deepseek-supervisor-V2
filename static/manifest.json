{
  "manifest_version": 3,
  "name": "DeepSeek Supervisor V2",
  "version": "1.0.0",
  "description": "A Chrome extension that enhances the DeepSeek chat experience by providing additional features and functionalities.",
  "permissions": ["storage"],
  "host_permissions": ["https://chat.deepseek.com/*", "https://*.deepseek.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*", "https://*.deepseek.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://chat.deepseek.com/*", "https://*.deepseek.com/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "DeepSeek Supervisor V2",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}